{#- Jinja2 Transform: render a router startup config for one device.
    The query (device_config) returns the device matched by the `device`
    variable; the GraphQL result is available here as `data`. -#}
{%- set device = data.DcimDevice.edges[0].node -%}
{%- set site = device.location.node -%}
{%- set mgmt_ip = device.primary_address.node.address.value -%}
! Managed by OtterNet SoT — {{ site.mgmt_domain.value }}
!
hostname {{ device.name.value }}
!
ip domain-name {{ device.fqdn.value }}
!
interface Management0
 ip address {{ mgmt_ip }}
!
router bgp {{ site.bgp_asn.value }}
 bgp router-id {{ mgmt_ip.split('/')[0] }}
 bgp log-neighbor-changes
!
end
