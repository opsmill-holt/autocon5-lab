{% set device = data["DcimDevice"]["edges"][0]["node"] %}
{% set location = device["location"]["node"] %}
{% set design = location.get("design", {}).get("node") if location else None %}
! Managed by OtterNet SoT
! Site: {{ location.get("shortname", {}).get("value", "unknown") if location else "unknown" }}
!
hostname {{ device["name"]["value"] }}
!
{% for iface_edge in device["interfaces"]["edges"] %}
{% set iface = iface_edge["node"] %}
interface {{ iface["name"]["value"] }}
{% if iface.get("ip_addresses") and iface["ip_addresses"]["edges"] %}
{% set ip_entry = iface["ip_addresses"]["edges"][0]["node"]["address"]["value"] %}
 ip address {{ ip_entry.split("/")[0] }} 255.255.255.0
{% else %}
 no ip address
{% endif %}
 no shutdown
!
{% endfor %}
{% if design and design.get("bgp_asn", {}).get("value") %}
router bgp {{ design["bgp_asn"]["value"] }}
 bgp router-id {{ device["name"]["value"] }}
 bgp log-neighbor-changes
!
{% endif %}
end
